# Gabarit local (non versionné — .gitignore couvre tous les .env*).
NUXT_PUBLIC_SITE_URL=https://emasterclass.bigfive.ci

# Projet Supabase : console → Settings.
SUPABASE_URL=

# Clé secrète (sb_secret_…) : Settings → API keys → Secret keys.
# Serveur uniquement — jamais la clé publishable ici.
SUPABASE_SECRET_KEY=

# Scelle les cookies de session (chiffrement + signature). 32 caractères
# minimum, à générer aléatoirement :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD=

# --- Vidéo -----------------------------------------------------------------
# Scelle les autorisations de lecture. Même valeur que le secret du Worker
# Cloudflare (`wrangler secret put VIDEO_SIGNING_SECRET`). 32 caractères
# minimum, à générer comme ci-dessus.
VIDEO_SIGNING_SECRET=

# Adresse du diffuseur — le Worker Cloudflare. Laisser vide pour passer par la
# route locale /medias, qui applique la même vérification de signature.
VIDEO_BASE_URL=https://emasterclass-videos.analyticsbigfive.workers.dev

# Double vérification admin (/admin/login) : `interne` (code écrit dans la sortie
# serveur tant qu'aucun fournisseur d'envoi n'existe) ou `supabase-auth`
# (Supabase Auth envoie le code à six chiffres par e-mail — gabarit « Magic Link »
# du projet à compléter avec {{ .Token }}, quota du SMTP intégré : quelques e-mails/heure).
CODE_ADMIN_FOURNISSEUR=interne
# Envois e-mail/WhatsApp de la plateforme : `console` tant qu'aucun pilote réel n'est branché.
NOTIFICATIONS_DRIVER=console
