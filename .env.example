# Gabarit local (non versionné — .gitignore couvre tous les .env*).
NUXT_PUBLIC_SITE_URL=https://emasterclass.bigfive.ci

# Projet Supabase : console → Settings.
SUPABASE_URL=

# Clé secrète (sb_secret_…) : Settings → API keys → Secret keys.
# Serveur uniquement — jamais la clé publishable ici.
SUPABASE_SECRET_KEY=

# Scelle les cookies de session (chiffrement + signature). 32 caractères
# minimum, à générer aléatoirement :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD=

# --- Vidéo -----------------------------------------------------------------
# Scelle les autorisations de lecture. Même valeur que le secret du Worker
# Cloudflare (`wrangler secret put VIDEO_SIGNING_SECRET`). 32 caractères
# minimum, à générer comme ci-dessus.
VIDEO_SIGNING_SECRET=

# Adresse du diffuseur — le Worker Cloudflare. Laisser vide pour passer par la
# route locale /medias, qui applique la même vérification de signature.
VIDEO_BASE_URL=https://emasterclass-videos.analyticsbigfive.workers.dev

# --- Paiement FeexPay (docs.feexpay.me) --------------------------------------
# `simulation` : aucun appel au prestataire, commande confirmée d'emblée
# (développement uniquement, refusé en production). `sandbox` : la fenêtre
# FeexPay joue un succès sans contacter le prestataire ni débiter personne, le
# tunnel se déroule en entier. `live` : production.
FEEXPAY_MODE=simulation
# Tableau de bord FeexPay → Développeurs : identifiant de la boutique et clé
# d'API (`fp_…`). La clé est transmise au navigateur pour ouvrir la fenêtre
# de paiement, comme le prévoit le SDK FeexPay.
FEEXPAY_SHOP_ID=
FEEXPAY_API_KEY=
# Clé partagée du webhook : à générer aléatoirement, puis sur le tableau de
# bord FeexPay (menu Webhook) déclarer l'URL https://<site>/api/paiements/feexpay/webhook
# avec « Type d'en-tête » Bearer et cette clé comme valeur (à défaut, ?cle=… dans l'URL).
FEEXPAY_WEBHOOK_CLE=
# FEEXPAY_BASE_URL=https://api-v2.feexpay.me

# --- Zoom (planche B, écran 11) ---------------------------------------------
# `simulation` : réunion fictive et salle simulée, aucun appel à Zoom.
# `live` : deux applications sur marketplace.zoom.us —
#   · Server-to-Server OAuth (scopes meeting:write:admin, meeting:read:admin)
#     pour créer les réunions à la planification ;
#   · Meeting SDK pour rejoindre la salle depuis la plateforme.
ZOOM_MODE=simulation
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SDK_CLIENT_ID=
ZOOM_SDK_CLIENT_SECRET=

# --- Google Agenda (planche C, écran 05 ; planche D, écran 05) --------------
# `simulation` : identifiant d'événement fictif, aucun appel à Google.
# `live` : console.cloud.google.com → activer l'API Google Calendar, créer un
# compte de service et sa clé JSON, puis dans Google Agenda partager l'agenda
# avec l'adresse du compte de service en « Apporter des modifications aux
# événements ». La clé privée du JSON se passe en base64 :
#   node -e "console.log(Buffer.from(require('./cle.json').private_key).toString('base64'))"
GOOGLE_AGENDA_MODE=simulation
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_CLE_PRIVEE=
# Adresse de l'agenda partagé (son « ID de l'agenda » dans les paramètres).
GOOGLE_AGENDA_ID=

# Tâches planifiées (purge des comptes supprimés après 14 jours, rappel J-3).
# Sur un serveur Node, Nitro les lance chaque nuit. Sur Vercel, déclarer un
# cron externe qui appelle POST https://<site>/api/taches/purger avec
# « Authorization: Bearer <cette clé> ». À générer aléatoirement.
TACHES_CLE=

# Double vérification admin (/admin/login) : `interne` (code écrit dans la sortie
# serveur tant qu'aucun fournisseur d'envoi n'existe) ou `supabase-auth`
# (Supabase Auth envoie le code à six chiffres par e-mail — gabarit « Magic Link »
# du projet à compléter avec {{ .Token }}, quota du SMTP intégré : quelques e-mails/heure),
# ou `aucun` pour suspendre la double vérification tant qu'aucun envoi n'est configuré.
CODE_ADMIN_FOURNISSEUR=interne

# Chiffrement des secrets TOTP au repos (32 caractères minimum, tirés au sort).
# Sans elle, l'enrôlement est refusé plutôt que d'écrire un secret en clair.
# La perdre rend les secrets illisibles : chaque administrateur devra se
# réenrôler, ses codes de secours restant valables entre-temps.
TOTP_CLE=
# Envois e-mail/WhatsApp de la plateforme : `console` tant qu'aucun pilote réel n'est branché.
NOTIFICATIONS_DRIVER=console

# Uniquement pour `npm run auth:configurer` (gabarit du code admin et SMTP dans
# Supabase Auth) : jeton d'accès personnel, supabase.com/dashboard/account/tokens.
# Jamais lu par l'application.
SUPABASE_ACCESS_TOKEN=
# SMTP personnalisé pour Supabase Auth (facultatif) : sans lui, le SMTP intégré,
# limité à quelques envois par heure.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_EXPEDITEUR=ne-pas-repondre@bigfive.ci
SMTP_NOM=E-Masterclass Big Five

# --- Encodage vidéo -----------------------------------------------------------
# L'exécutant (`npm run video:encoder`) tourne sur une machine à part : ni le
# Worker Cloudflare ni l'hébergement de l'application ne peuvent exécuter
# ffmpeg. Il lui faut ffmpeg et ffprobe dans le PATH, les identifiants R2 de
# wrangler, et ces trois valeurs.
#
# Adresse de l'application, vue depuis l'exécutant.
APP_URL=
# Nombre de reprises avant de déclarer un fichier inencodable. Sans plafond, il
# reprendrait indéfiniment sa place dans la file.
ENCODAGE_TENTATIVES_MAX=3
# Au-delà de ce délai, un travail « en encodage » est rendu à la file : son
# exécutant est présumé mort (machine éteinte, conteneur recyclé).
ENCODAGE_MINUTES_ABANDON=60
# Attente entre deux sondages quand la file est vide, en mode `--boucle`.
ENCODAGE_REPOS_SECONDES=30
# Compromis vitesse/débit de libx264. `medium` par défaut ; `veryfast` si
# l'exécutant est une machine modeste et que le temps presse.
VIDEO_PRESET=medium
